__pycache__/
tools/__pycache__/
*.pyc

# Process drafts: the chapter II translation was produced in four fragments and later
# reviewed in two halves. The assembled, reviewed text lives in sources/zh/*.zh.md;
# the drafts are kept locally for provenance only.
sources/zh/attic/

# Fetched web edition (tools/fetch_source.py regenerates it)
# sources/whitehouse-science.html is committed on purpose: it pins the exact revision
# of the web edition that sources/en/*.en.md was extracted from.

# The web edition's figures are copied here from 对照稿/images/ by tools/build_web.py;
# docs/images/ (the rendered site) is committed because GitHub Pages serves docs/.
web/images/